# Supabase — Project Settings → API. The service role key is server-only and
# must never be prefixed NEXT_PUBLIC_; this app sends no Supabase key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Signs the member and staff session cookies. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=

# Shared passcode that unlocks /staff on the shop's device. Short enough to
# tap in at a counter, so the unlock throttle in migration 0005 is what keeps
# it from being guessed — see the note there before removing it.
STAFF_PASSCODE=
